timeout: {TIMEOUT}
default_entry: {DEFAULT_ENTRY}

interface_branding: NasuaOS
interface_branding_color: 00aaaa
interface_help_hidden: {HELP_HIDDEN}
interface_help_color: 00aa00
interface_help_color_bright: aaaaaa
interface_resolution: {RESOLUTION}
interface_rotation: 0

wallpaper: boot():{WALLPAPER}
wallpaper_style: stretched
backdrop: 000000

firmware_logo: no
editor_enabled: no
hash_mismatch_panic: no

# Debug
verbose: {VERBOSE}

/Boot Kernel
    protocol: multiboot2
    if_arch: x86-64 ia-32
    path: boot():/boot/utils/boot_mgr_x86
    module_path: boot():/boot/kernel_32bit/x86/kernel
    module_string: kernel_32bit
    module_path: boot():/boot/kernel_64bit/x86/kernel
    module_string: kernel_64bit
    module_path: boot():/system/rootfs.img
    module_string: rootfs.img
    module_path: boot():/config/boot_config.txt
    module_string: boot_config.txt
    module_path: boot():/config/defaults.txt
    module_string: defaults.txt
    resolution: {RESOLUTION}
    comment: Configure and select available NasuaOS boot environments

/Boot Kernel
    protocol: limine
    if_arch: aarch64
    path: boot():/boot/utils/boot_mgr_arm
    module_path: boot():/boot/kernel_64bit/arm/kernel
    module_string: kernel_64bit
    module_path: boot():/system/rootfs.img
    module_string: rootfs.img
    module_path: boot():/config/boot_config.txt
    module_string: boot_config.txt
    module_path: boot():/config/defaults.txt
    module_string: defaults.txt
    resolution: {RESOLUTION}
    comment: Universal boot manager for 64-bit ARM

/Boot Kernel
    protocol: limine
    if_arch: riscv64
    path: boot():/boot/utils/boot_mgr_riscv
    module_path: boot():/boot/kernel_64bit/risc-v/kernel
    module_string: kernel_64bit
    module_path: boot():/system/rootfs.img
    module_string: rootfs.img
    module_path: boot():/config/boot_config.txt
    module_string: boot_config.txt
    module_path: boot():/config/defaults.txt
    module_string: defaults.txt
    resolution: {RESOLUTION}
    comment: Universal boot manager for 64-bit RISC-V

